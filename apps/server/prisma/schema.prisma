generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum MovementType {
  PURCHASE_RECEIPT
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum TransferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  DISPATCHED
  PARTIALLY_RECEIVED
  RECEIVED
  COMPLETED
  CANCELLED
  REJECTED
}

enum AdjustmentReason {
  DAMAGED
  FOUND
  CYCLE_COUNT
  EXPIRED
  THEFT
  OTHER
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users                User[]
  locations            Location[]
  categories           Category[]
  products             Product[]
  suppliers            Supplier[]
  stockBalances        StockBalance[]
  stockMovements       StockMovement[]
  stockTransfers       StockTransfer[]
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  inventoryAdjustments InventoryAdjustment[]

  @@map("organizations")
}

model Location {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String
  address        String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userAccess           UserLocationAccess[]
  stockBalances        StockBalance[]
  stockMovements       StockMovement[]
  outgoingTransfers    StockTransfer[]       @relation("SourceLocation")
  incomingTransfers    StockTransfer[]       @relation("DestLocation")
  purchaseOrders       PurchaseOrder[]
  inventoryAdjustments InventoryAdjustment[]

  @@unique([organizationId, code])
  @@map("locations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  fullName       String   @map("full_name")
  role           Role     @default(STAFF)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationAccess         UserLocationAccess[]
  requestedTransfers     StockTransfer[]        @relation("RequestedBy")
  approvedTransfers      StockTransfer[]        @relation("ApprovedBy")
  transferStatusChanges  TransferStatusHistory[]
  createdAdjustments     InventoryAdjustment[]

  @@map("users")
}

model UserLocationAccess {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  locationId String   @map("location_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@map("user_location_access")
}

model Category {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
  @@map("categories")
}

model Product {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  categoryId     String   @map("category_id")
  sku            String
  name           String
  description    String?
  unitOfMeasure  String   @default("units") @map("unit_of_measure")
  minThreshold   Decimal  @default(10) @db.Decimal(12, 4) @map("min_threshold")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category             Category              @relation(fields: [categoryId], references: [id])
  stockBalances        StockBalance[]
  stockMovements       StockMovement[]
  transferItems        StockTransferItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  inventoryAdjustments InventoryAdjustment[]

  @@unique([organizationId, sku])
  @@map("products")
}

model StockBalance {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  locationId      String   @map("location_id")
  productId       String   @map("product_id")
  onHand          Decimal  @default(0) @db.Decimal(12, 4) @map("on_hand")
  reserved        Decimal  @default(0) @db.Decimal(12, 4) @map("reserved")
  averageUnitCost Decimal  @default(0) @db.Decimal(14, 2) @map("average_unit_cost")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([organizationId, locationId, productId])
  @@map("stock_balances")
}

model StockMovement {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  locationId     String       @map("location_id")
  productId      String       @map("product_id")
  movementType   MovementType @map("movement_type")
  quantity       Decimal      @db.Decimal(12, 4)
  unitCost       Decimal      @db.Decimal(14, 2) @map("unit_cost")
  balanceAfter   Decimal      @db.Decimal(12, 4) @map("balance_after")
  referenceType  String?      @map("reference_type")
  referenceId    String?      @map("reference_id")
  reason         String?
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId, locationId, productId])
  @@map("stock_movements")
}

model StockTransfer {
  id                    String         @id @default(uuid())
  organizationId        String         @map("organization_id")
  transferNumber        String         @unique @map("transfer_number")
  sourceLocationId      String         @map("source_location_id")
  destinationLocationId String         @map("destination_location_id")
  status                TransferStatus @default(DRAFT)
  requestedById         String         @map("requested_by_id")
  approvedById          String?        @map("approved_by_id")
  notes                 String?
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceLocation      Location                @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  destinationLocation Location                @relation("DestLocation", fields: [destinationLocationId], references: [id])
  requestedBy         User                    @relation("RequestedBy", fields: [requestedById], references: [id])
  approvedBy          User?                   @relation("ApprovedBy", fields: [approvedById], references: [id])
  items               StockTransferItem[]
  statusHistory       TransferStatusHistory[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id           String   @id @default(uuid())
  transferId   String   @map("transfer_id")
  productId    String   @map("product_id")
  requestedQty Decimal  @db.Decimal(12, 4) @map("requested_qty")
  dispatchedQty Decimal? @db.Decimal(12, 4) @map("dispatched_qty")
  receivedQty  Decimal? @db.Decimal(12, 4) @map("received_qty")

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@map("stock_transfer_items")
}

model TransferStatusHistory {
  id         String          @id @default(uuid())
  transferId String          @map("transfer_id")
  fromStatus TransferStatus? @map("from_status")
  toStatus   TransferStatus  @map("to_status")
  changedById String         @map("changed_by_id")
  notes      String?
  createdAt  DateTime        @default(now()) @map("created_at")

  transfer  StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  changedBy User          @relation(fields: [changedById], references: [id])

  @@map("transfer_status_history")
}

model Supplier {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String
  contactEmail   String?  @map("contact_email")
  phone          String?
  address        String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, code])
  @@map("suppliers")
}

model PurchaseOrder {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  supplierId     String   @map("supplier_id")
  locationId     String   @map("location_id")
  orderNumber    String   @unique @map("order_number")
  status         String   @default("OPEN")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  location      Location            @relation(fields: [locationId], references: [id])
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  purchaseOrderId String  @map("purchase_order_id")
  productId       String  @map("product_id")
  orderedQty      Decimal @db.Decimal(12, 4) @map("ordered_qty")
  unitPrice       Decimal @db.Decimal(14, 2) @map("unit_price")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  purchaseOrderId String   @map("purchase_order_id")
  receiptNumber   String   @unique @map("receipt_number")
  receivedDate    DateTime @default(now()) @map("received_date")

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  items         GoodsReceiptItem[]

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String  @id @default(uuid())
  goodsReceiptId String  @map("goods_receipt_id")
  productId      String  @map("product_id")
  receivedQty    Decimal @db.Decimal(12, 4) @map("received_qty")
  unitCost       Decimal @db.Decimal(14, 2) @map("unit_cost")

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@map("goods_receipt_items")
}

model InventoryAdjustment {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  locationId     String           @map("location_id")
  productId      String           @map("product_id")
  deltaQuantity  Decimal          @db.Decimal(12, 4) @map("delta_quantity")
  reason         AdjustmentReason
  notes          String?
  createdById    String           @map("created_by_id")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@map("inventory_adjustments")
}
