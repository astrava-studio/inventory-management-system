# Environment Configuration for Backend
PORT=4000
NODE_ENV=development

# JWT Secret for Auth
JWT_SECRET=super-secret-inventory-jwt-key-2026-phase1
JWT_EXPIRES_IN=7d

# Aiven PostgreSQL Free Tier connection string:
# Critical parameters: sslmode=require, connection_limit=5, pool_timeout=15
DATABASE_URL="postgresql://avnadmin:YOUR_PASSWORD@YOUR_AIVEN_HOST:YOUR_PORT/defaultdb?sslmode=require&connection_limit=5&pool_timeout=15"
